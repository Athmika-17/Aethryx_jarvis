# GEMINI_API_KEY: Required for Gemini AI Assistant server-side calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# EARTHDATA_TOKEN: Optional NASA Earthdata Login Bearer Token for authenticated GES DISC / LP DAAC granule downloads.
# Obtain a token at https://urs.earthdata.nasa.gov/
EARTHDATA_TOKEN=""

# DB_PATH: Optional SQLite file path for local persistence (defaults to ./data/aethryx.db).
# Note: On ephemeral serverless deployments, use an external volume or managed database for durable persistence.
DB_PATH="./data/aethryx.db"

# CORS_ORIGIN: Optional comma-separated allowed origins in production.
CORS_ORIGIN=""
